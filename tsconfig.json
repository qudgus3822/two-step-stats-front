{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* [신설: 2026-09-02 13:00, 김병현 수정] shadcn/Tailwind 경로 별칭('@/...') 용.
       vite.config.ts 의 resolve.alias 와 짝이어야 한다. */
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },

    /* 번들러(Vite)가 모듈을 처리하므로 bundler 해석 방식 사용 */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* 타입 안전을 위해 엄격 모드 + 미사용 검사 켬 */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"]
}
